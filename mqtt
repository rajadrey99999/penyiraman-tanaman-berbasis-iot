}


unsigned long lastExecutionTime = 0;
unsigned long timeZero = 0;
void sendToMQTT(String task) {

    float temperature = dht.readTemperature();
    float humidity = dht.readHumidity();

    if (isnan(humidity) || isnan(temperature)) {
      Serial.println("Gagal membaca sensor DHT11!\n");
    } else {
      Serial.print("Suhu: ");
      Serial.print(temperature);
      Serial.println("°C");
      Serial.print("Kelembaban: ");
      Serial.print(humidity);
      Serial.println("%");
    }

    int plantcare;

    if (task == "Auto") {
      if (humidity < humiMinimum && (millis() - lastExecutionTime) >= timeZero) {
        Serial.println("Humidity berada di batas minimum! Fungsi dijalankan!\n");
        digitalWrite(POMPA_PIN, LOW);
        digitalWrite(LED1_PIN, HIGH);
        delay(10000);
        digitalWrite(POMPA_PIN, HIGH);
        digitalWrite(LED1_PIN, LOW);
        plantcare = 1;
        timeZero = timeLimitCare;
        lastExecutionTime = millis();
      } else {
        plantcare = 0;
      }
    } else if (task == "Manual") {
      plantcare = 1;
    }

    String messWarn = "";
    String messWarnTemp = "";
    String messWarnHum = "";

    if (temperature <= tempMinimum) {
        messWarnTemp = "Suhu Dingin!";
    } else if (temperature >= tempMaximum) {
        messWarnTemp = "Suhu Panas!";
    }

    if (humidity < humiMinimum) {
        messWarnHum = "Kelembapan Kurang";
    }

    int countInt = 0;
    if (temperature <= tempMinimum || temperature >= tempMaximum) {
        if (humidity < humiMinimum) {
          messWarn = messWarnHum + " & " + messWarnTemp;
        } else {
          messWarn = messWarnTemp;
        }
        countInt = 1;
    } else if (humidity < humiMinimum) {
        messWarn = messWarnHum + "!";
        countInt = 1;
    }

    String tempStr = String(temperature, 1);
    String humidityStr = String(humidity, 1);

    // String JSON = "{\"id_device\":" + String(idDevice) + ",\"data_count\":" + String(countInt) + ",\"information\":[{\"temperature\":" + tempStr + ",\"humidity\":" + humidityStr + ",\"plantcare\":" + String(plantcare) + "}],\"warning\":\"" + messWarn + "\"}";
    // String JSON = "{\"slug\":\"" + slug + "\"," +
    //           "\"id_device\":\"10\"," +
    //           "\"data_count\":1," +
    //           "\"information\":[{\"temperature\":-100," +
    //           "\"humidity\":41," +
    //           "\"plantcare\":1}]," +
    //           "\"warning\":\"\"}";
    String JSON = "{\"slug\":\"" + String(slug) + "\",\"id_device\":" + String(idDevice) + ",\"data_count\":" + String(countInt) + ",\"information\":[{\"temperature\":" + tempStr + ",\"humidity\":" + humidityStr + ",\"plantcare\":" + String(plantcare) + "}],\"warning\":\"" + messWarn + "\"}";


    if (client.connected()) {
        String topic = topicMQTT;
        if (client.publish(topic.c_str(), JSON.c_str())) {
            Serial.println("Data terkirim via MQTT");
        } else {
            Serial.println("Gagal mengirim data via MQTT");
        }
    } else {
        Serial.println("Tidak ada koneksi MQTT");
    }
}


void mqttCallback(char* topic, byte* payload, unsigned int length) {
    String message;
    for (unsigned int i = 0; i < length; i++) {
        message += (char)payload[i];
    }
    Serial.print("Message received on topic ");
    Serial.print(topic);
    Serial.print(": ");
    Serial.println(message);
    
    if (String(topic) == topicMQTT) {
      if (message == String(messageReceiver) + "" + String(idDevice) + "" + String(slug)) {
            Serial.println("Penyiraman dari jarak jauh!\n");
            digitalWrite(POMPA_PIN, LOW);
            digitalWrite(LED1_PIN, HIGH);
            delay(10000);
            digitalWrite(POMPA_PIN, HIGH);
            digitalWrite(LED1_PIN, LOW);
            if (millis() - lastDHTReadTime >= dhtInterval) {
                sendToMQTT("Manual");
                lastDHTReadTime = millis();
            }
        }
    }
}

void reconnect() {
  while (!client.connected()) {
    Serial.print("Attempting MQTT connection...");
    if (client.connect(mqttClientId, mqttUser, mqttPassword)) {
      Serial.println("connected");
      client.subscribe(topicMQTT);
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      delay(5000);
    }
  }
}
